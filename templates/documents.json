[
  {
    "id": "Mutual-NDA",
    "name": "Mutual Non-Disclosure Agreement",
    "description": "Common Paper mutual NDA: the parties set the purpose, term and confidentiality period for sharing confidential information.",
    "template": "Mutual-NDA.md",
    "fields": [
      {"key": "purpose", "label": "Purpose", "hint": "How Confidential Information may be used"},
      {"key": "effectiveDate", "label": "Effective date", "hint": "YYYY-MM-DD"},
      {"key": "mndaTermType", "label": "MNDA term", "hint": "expires or continues until terminated", "options": ["expires", "continues"]},
      {"key": "mndaTermYears", "label": "MNDA term in years", "hint": "digits only, e.g. 2"},
      {"key": "confidentialityType", "label": "Confidentiality term", "hint": "years or perpetuity", "options": ["years", "perpetuity"]},
      {"key": "confidentialityYears", "label": "Confidentiality term in years", "hint": "digits only, e.g. 3"},
      {"key": "governingLaw", "label": "Governing law (state)", "hint": "e.g. Delaware"},
      {"key": "jurisdiction", "label": "Jurisdiction", "hint": "city or county and state"},
      {"key": "modifications", "label": "Modifications to the MNDA", "hint": "free text, or none"},
      {"key": "party1Name", "label": "Party 1 name", "hint": "full name of the signatory"},
      {"key": "party1Title", "label": "Party 1 title", "hint": ""},
      {"key": "party1Company", "label": "Party 1 company", "hint": ""},
      {"key": "party1NoticeAddress", "label": "Party 1 notice address", "hint": "email or postal address"},
      {"key": "party1Date", "label": "Party 1 signature date", "hint": "YYYY-MM-DD"},
      {"key": "party2Name", "label": "Party 2 name", "hint": "full name of the signatory"},
      {"key": "party2Title", "label": "Party 2 title", "hint": ""},
      {"key": "party2Company", "label": "Party 2 company", "hint": ""},
      {"key": "party2NoticeAddress", "label": "Party 2 notice address", "hint": "email or postal address"},
      {"key": "party2Date", "label": "Party 2 signature date", "hint": "YYYY-MM-DD"}
    ]
  },
